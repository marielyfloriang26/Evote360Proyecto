 @model Evote360.Application.ViewModels.AlianzaPolitica.AlianzaPoliticaViewModel

 @* Alianzas Vigentes (Establecidas oficialmente) *@
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-handshake"></i> Alianzas Vigentes</h5>
                    <span class="badge bg-white text-success">@Model.AlianzasVigentes.Count</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Partido Aliado</th>
                                    <th>Fecha de Aceptación</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.AlianzasVigentes.Any())
                                {
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-3">Tu partido no posee alianzas vigentes para este proceso.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.AlianzasVigentes)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-shield-check text-success fs-4 me-2"></i>
                                                    <div>
                                                        <strong>@item.PartidoAliadoNombre</strong> <br />
                                                        <span class="badge bg-light text-dark border">@item.PartidoAliadoSiglas</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@item.FechaAceptacion</td>
                                            <td>
                                                <a asp-action="EliminarAlianza" asp-route-id="@item.Id" class="btn btn-sm btn-danger @(Model.ExisteEleccionActiva ? "disabled" : "")">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>