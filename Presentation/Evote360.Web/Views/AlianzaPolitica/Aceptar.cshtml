@model Evote360.Application.ViewModels.AlianzaPolitica.SolicitudAlianzaViewModel

@{
    ViewData["Title"] = "Confirmar Alianza Política";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-handshake"></i> Confirmar Establecimiento de Alianza
                    </h5>
                </div>
                <div class="card-body text-center py-4">
                    <div class="text-success mb-3">
                        <i class="bi bi-exclamation-triangle-fill display-4"></i>
                    </div>
                    
                    <h4 class="card-title mb-3">¿Desea aceptar la alianza política?</h4>
                    <p class="text-muted px-3">
                        Está a punto de formalizar un acuerdo electoral con el partido 
                        <strong class="text-dark">@Model.PartidoNombre (@Model.PartidoSiglas)</strong>. 
                        Esta solicitud fue recibida el @Model.FechaSolicitud.
                    </p>

                    <div class="alert alert-warning small text-start mx-3" role="alert">
                        <i class="bi bi-info-circle-fill"></i> <strong>Nota importante:</strong> Al consolidar esta alianza, se unificarán los criterios de votación correspondientes según las reglas del proceso electoral vigente.
                    </div>

                    <form asp-action="Aceptar" asp-route-id="@Model.Id" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-check-circle"></i> Sí, Aceptar Alianza
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>