@model Evote360.Application.ViewModels.AlianzaPolitica.AlianzaPoliticaViewModel

@* Solicitudes Enviadas (Realizadas por mi partido) *@
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-info">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-send"></i> Solicitudes Enviadas</h5>
                    <span class="badge bg-white text-info">@Model.SolicitudesRealizadas.Count</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Partido Receptor</th>
                                    <th>Fecha de Solicitud</th>
                                    <th>Estado</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.SolicitudesRealizadas.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-3">No has enviado ninguna solicitud recientemente.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.SolicitudesRealizadas)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@item.PartidoNombre</strong> <br />
                                                <small class="text-muted">@item.PartidoSiglas</small>
                                            </td>
                                            <td>@item.FechaSolicitud</td>
                                            <td>
                                                <span class="badge @(item.Estado == "Aceptada" ? "bg-success" : "bg-warning text-dark")">
                                                    @item.Estado
                                                </span>
                                            </td>
                                            <td>
                                                @if (item.Estado != "Aceptada")
                                                {
                                                    <a asp-action="EliminarSolicitud"
                                                    asp-route-id="@item.Id" 
                                                    class="btn btn-sm btn-outline-danger @(Model.ExisteEleccionActiva ? "disabled" : "")">
                                                        <i class="bi bi-trash"></i> Eliminar
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small"><i class="bi bi-lock-fill"></i> Consolidada</span>
                                                }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>