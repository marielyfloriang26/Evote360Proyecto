@model Evote360.Application.ViewModels.AlianzaPolitica.CrearSolicitudAlianzaViewModel

@{
    ViewData["Title"] = "Nueva Solicitud de Alianza";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-plus"></i> Registrar Solicitud de Alianza</h5>
                </div>
                <div class="card-body">
                    
                    @* Sumario de errores de negocio devueltos por el Servicio *@
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <p class="text-muted small">
                        Seleccione el partido político al cual desea enviarle una propuesta de alianza formal. 
                        Recuerde que el partido receptor debe estar activo y no poseer alianzas previas.
                    </p>

                    <form asp-action="Crear" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label asp-for="PartidoReceptorId" class="form-label fw-bold">Partido Político Destinatario</label>
                            <select asp-for="PartidoReceptorId" asp-items="Model.PartidosDisponibles" class="form-select form-select-lg">
                                <option value="">-- Seleccione un Partido Político --</option>
                            </select>
                            <span asp-validation-for="PartidoReceptorId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left-short"></i> Regresar
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-send-check"></i> Enviar Propuesta
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
   
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}