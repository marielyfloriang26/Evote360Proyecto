@model Evote360.Application.ViewModels.Candidatos.EditarCandidatoViewModel

@{
    ViewData["Title"] = "Editar Candidato";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Editar Candidato</h4>
        </div>
        <div class="card-body">
            <form asp-action="Editar" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FotoUrlActual" />
                <input type="hidden" asp-for="HaParticipado" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                @if (Model.HaParticipado)
                {
                    <div class="alert alert-info small">
                        Este candidato ya ha participado en una elección, por lo que no puede modificar sus datos principales (nombre, apellido y foto).
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold">Nombre</label>
                    <input asp-for="Nombre" class="form-control" readonly="@(Model.HaParticipado ? "readonly" : null)" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Apellido" class="form-label fw-bold">Apellido</label>
                    <input asp-for="Apellido" class="form-control" readonly="@(Model.HaParticipado ? "readonly" : null)" />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Foto" class="form-label fw-bold">Foto del Candidato</label>
                    @if (Model.HaParticipado)
                    {
                        <input type="file" class="form-control" disabled />
                    }
                    else
                    {
                        <input asp-for="Foto" type="file" class="form-control" accept=".png, .jpg, .jpeg" />
                    }
                    <span asp-validation-for="Foto" class="text-danger"></span>

                    @if (!string.IsNullOrEmpty(Model.FotoUrlActual))
                    {
                        <div class="mt-2 d-flex align-items-center gap-2">
                            <span class="text-muted small">Foto actual:</span>
                            <img src="@Model.FotoUrlActual" alt="Foto" class="rounded-circle" style="height: 50px; width: 50px; object-fit: cover; border: 1px solid #ddd;" onerror="this.onerror=null; this.src='';"/>
                        </div>
                    }
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="Estado" class="form-check-input" type="checkbox" role="switch">
                    <label asp-for="Estado" class="form-check-label fw-bold">Estado Activo</label>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
                    <button type="submit" class="btn btn-warning">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
