@model Evote360.Application.ViewModels.SavePartidoPoliticoViewModel

@{
    ViewData["Title"] = "Crear Partido Político";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Crear Partido Político</h4>
        </div>
        <div class="card-body">
            <form asp-action="Crear" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold">Nombre del Partido</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej. Partido Revolucionario Moderno" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Siglas" class="form-label fw-bold">Siglas</label>
                    <input asp-for="Siglas" class="form-control" placeholder="Ej. PRM" />
                    <span asp-validation-for="Siglas" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="File" class="form-label fw-bold">Logo del Partido</label>
                    <input asp-for="File" type="file" class="form-control" accept=".png, .jpg, .jpeg" />
                    <span asp-validation-for="File" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-bold">Descripción (Opcional)</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Breve historia o principios del partido..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="Estado" class="form-check-input" type="checkbox" role="switch" checked>
                    <label asp-for="Estado" class="form-check-label fw-bold">Estado Activo</label>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
                    <button type="submit" class="btn btn-primary">Crear partido político</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}