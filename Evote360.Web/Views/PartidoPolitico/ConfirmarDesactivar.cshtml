@model int

@{
    ViewData["Title"] = "Confirmar Desactivación";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card border-danger shadow">
        <div class="card-body text-center p-4">
            <div class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem;"></i>
            </div>
            <h4 class="card-title mb-3">Confirmar Desactivación</h4>
            <p class="card-text text-muted">¿Está seguro que desea desactivar este partido político?</p>
            <h5 class="fw-bold mb-4 text-dark">"@ViewBag.NombrePartido"</h5>

            <form asp-action="Desactivar" method="post" class="d-flex justify-content-around">
                <input type="hidden" name="id" value="@Model" />
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                <button type="submit" class="btn btn-danger px-4">Aceptar</button>
            </form>
        </div>
    </div>
</div>