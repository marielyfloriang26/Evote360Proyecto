@model Evote360.Application.ViewModels.AlianzaPolitica.SolicitudAlianzaViewModel

@{
    ViewData["Title"] = "Rechazar Solicitud de Alianza";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-x-octagon"></i> Rechazar Solicitud de Alianza
                    </h5>
                </div>
                <div class="card-body text-center py-4">
                    <div class="text-danger mb-3">
                        <i class="bi bi-shield-slash display-4"></i>
                    </div>
                    
                    <h4 class="card-title mb-3">¿Está seguro de rechazar esta solicitud?</h4>
                    <p class="text-muted px-3">
                        La propuesta enviada por el partido <strong class="text-dark">@Model.PartidoNombre (@Model.PartidoSiglas)</strong> 
                        será marcada como rechazada y se notificará a sus respectivos dirigentes.
                    </p>

                    <div class="alert alert-light border small text-start mx-3 text-secondary" role="alert">
                        <i class="bi bi-clock"></i> Fecha de emisión original: @Model.FechaSolicitud
                    </div>

                    <form asp-action="Rechazar" asp-route-id="@Model.Id" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left-short"></i> Volver atrás
                            </a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash"></i> Confirmar Rechazo
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>