@{
    ViewData["Title"] = "Confirmar Desvinculación";
    int asignacionId = ViewBag.AsignacionId;
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card border-danger shadow">
        <div class="card-body text-center p-4">
            <div class="text-danger mb-3">
                <i class="bi bi-exclamation-octagon" style="font-size: 3rem;"></i>
            </div>
            <h4 class="card-title text-danger mb-3">Confirmar Acción</h4>
            <p class="card-text text-muted fs-5">
                ¿Está seguro que desea desvincular este candidato de este puesto electivo?
            </p>
            
            <p class="small text-warning bg-light p-2 rounded">
                <i class="bi bi-info-circle"></i> Nota: Solo se eliminará la relación interna en la boleta; el candidato y el puesto seguirán existiendo en el sistema.
            </p>

            <div class="d-flex justify-content-center gap-3 mt-4">
                <a asp-action="Index" class="btn btn-secondary px-4">
                    Cancelar
                </a>
                <form asp-action="Eliminar" asp-route-id="@asignacionId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">
                        Aceptar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>