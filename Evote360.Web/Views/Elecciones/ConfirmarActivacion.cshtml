@model Evote360.Application.DTOs.EleccionDto
<div class="container mt-5 text-center" style="max-width: 500px;">
    <div class="card card-body shadow py-4">
        <h4 class="mb-4">¿Está seguro que desea activar esta elección?</h4>
        <p class="text-muted">Proceso: <strong>@Model.Nombre</strong></p>
        <form asp-action="Activar" asp-route-id="@Model.Id" method="post">
            <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
            <button type="submit" class="btn btn-success">Confirmar Activación</button>
        </form>
    </div>
</div>