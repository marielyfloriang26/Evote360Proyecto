@model List<ResultadoPuestoDto>

@{
    ViewData["Title"] = "Resultados";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0 text-primary">Resultados del Escrutinio Oficial</h2>
            <h5 class="text-muted">@ViewBag.EleccionNombre</h5>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver al Panel</a>
    </div>

    @foreach (var puesto in Model)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Puesto Electivo: @puesto.PuestoNombre</h5>
                @if (puesto.ExisteEmpatePrimerLugar)
                {
                    <span class="badge bg-warning text-dark fw-bold"><i class="bi bi-exclamation-triangle"></i> Alerta de Empate</span>
                }
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Candidato / Opción</th>
                            <th>Partido Político</th>
                            <th class="text-center">Votos</th>
                            <th class="text-center">Porcentaje</th>
                            <th class="text-end pe-3">Estatus</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var opcion in puesto.Opciones)
                        {
                            var rowStyle = opcion.EsGanador ? "table-success fw-bold" : "";
                            <tr class="@rowStyle">
                                <td class="ps-3">
                                    @opcion.CandidatoNombre
                                    @if (opcion.EsGanador)
                                    {
                                        <span class="ms-2 badge bg-success text-white">Electo</span>
                                    }
                                </td>
                                <td>
                                    @if (opcion.PartidoSiglas != "N/A")
                                    {
                                        <span>@opcion.PartidoNombre <strong class="text-muted">(@opcion.PartidoSiglas)</strong></span>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic">@opcion.PartidoNombre</span>
                                    }
                                </td>
                                <td class="text-center">@opcion.CantidadVotos</td>
                                <td class="text-center">@opcion.PorcentajeVotos%</td>
                                <td class="text-end pe-3">
                                    @if (opcion.EsGanador)
                                    {
                                        <span class="text-success fw-bold">Ganador</span>
                                    }
                                    else if (puesto.ExisteEmpatePrimerLugar && puesto.Opciones.First().CantidadVotos == opcion.CantidadVotos)
                                    {
                                        <span class="text-warning small fw-bold">Empatado</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>