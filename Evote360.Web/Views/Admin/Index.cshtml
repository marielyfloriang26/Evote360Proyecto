@model Evote360.Application.ViewModels.Admin.AdminHomeViewModel
@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container mt-4">
    <h1 class="text-center mb-4 text-primary fw-bold">Panel Principal de Administración</h1>

    <!-- Menú principal del administrador solicitado en el PDF -->
    <div class="card shadow-sm mb-4">
        <div class="card-body bg-light">
            <div class="row g-2 text-center">
                <div class="col-6 col-md-4 col-lg-2">
                    <a asp-controller="PuestoElectivo" asp-action="Index" class="btn btn-outline-primary w-100 py-2 fw-semibold">Puesto Electivo</a>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <a asp-controller="Ciudadano" asp-action="Index" class="btn btn-outline-primary w-100 py-2 fw-semibold">Ciudadanos</a>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <a asp-controller="PartidoPolitico" asp-action="Index" class="btn btn-outline-primary w-100 py-2 fw-semibold">Partidos Políticos</a>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <a asp-controller="Usuario" asp-action="Index" class="btn btn-outline-primary w-100 py-2 fw-semibold">Usuarios</a>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <a asp-controller="AsignacionDirigentePolitico" asp-action="Index" class="btn btn-outline-primary w-100 py-2 fw-semibold">Asignación de Dirigentes</a>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <a asp-controller="Elecciones" asp-action="Index" class="btn btn-outline-primary w-100 py-2 fw-semibold">Elecciones</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección de Resumen Electoral por Año -->
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h3 class="card-title h5 mb-0 text-secondary fw-bold">Resumen Electoral por Año</h3>
        </div>
        <div class="card-body">
            <form asp-controller="Admin" asp-action="Index" method="get" class="row g-3 align-items-end mb-4">
                <div class="col-12 col-sm-8 col-md-6">
                    <label for="anioElectoral" class="form-label fw-semibold">Año electoral *</label>
                    @if (Model.AniosDisponibles != null && Model.AniosDisponibles.Any())
                    {
                        <select id="anioElectoral" name="anioElectoral" class="form-select">
                            @foreach (var anio in Model.AniosDisponibles)
                            {
                                if (Model.AnioSeleccionado == anio)
                                {
                                    <option value="@anio" selected="selected">@anio</option>
                                }
                                else
                                {
                                    <option value="@anio">@anio</option>
                                }
                            }
                        </select>
                    }
                    else
                    {
                        <select id="anioElectoral" class="form-select text-muted" disabled>
                            <option>No existen elecciones registradas en el sistema.</option>
                        </select>
                    }
                </div>
                <div class="col-12 col-sm-4 col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Obtener Resumen Electoral</button>
                </div>
            </form>

            <div asp-validation-summary="All" class="text-danger mb-3 font-weight-bold"></div>

            @if (ViewBag.InfoMessage != null)
            {
                <div class="alert alert-info border-0 shadow-sm" role="alert">
                    <i class="bi bi-info-circle-fill me-2"></i> @ViewBag.InfoMessage
                </div>
            }
            else if (Model.EleccionesResumen != null && Model.EleccionesResumen.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover border align-middle">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="fw-bold text-secondary">Nombre de la elección</th>
                                <th scope="col" class="fw-bold text-secondary">Fecha de realización</th>
                                <th scope="col" class="text-center fw-bold text-secondary">Cantidad de partidos participantes</th>
                                <th scope="col" class="text-center fw-bold text-secondary">Cantidad de candidatos participantes</th>
                                <th scope="col" class="text-center fw-bold text-secondary">Cantidad de ciudadanos que votaron</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.EleccionesResumen)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.NombreEleccion</td>
                                    <td>@item.FechaRealizacion.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center fw-bold text-dark">@item.CantidadPartidos</td>
                                    <td class="text-center fw-bold text-dark">@item.CantidadCandidatos</td>
                                    <td class="text-center fw-bold text-primary">@item.CantidadCiudadanosVotaron.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>