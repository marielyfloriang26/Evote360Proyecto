@model Evote360.Application.DTOs.CiudadanoSaveDto
@{
    ViewData["Title"] = "Confirmar Desactivación";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card border-danger shadow">
        <div class="card-body text-center py-4">
            <div class="text-danger mb-3">
                <i class="fas fa-user-slash fa-4x"></i>
            </div>
            <h4 class="card-title text-danger">Confirmar Desactivación</h4>
            <p class="card-text fs-5">
                ¿Está seguro que desea desactivar este ciudadano?
            </p>
            <div class="bg-light p-3 rounded mb-4 text-start">
                <strong>Ciudadano:</strong> @Model.Nombre @Model.Apellido <br/>
                <strong>Documento:</strong> @Model.Cedula
            </div>
            <form asp-action="Desactivar" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-around">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-danger px-4">Aceptar</button>
                </div>
            </form>
        </div>
    </div>
</div>