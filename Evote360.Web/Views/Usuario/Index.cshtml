@model List<Evote360.Application.ViewModels.Usuario.UsuarioViewModel>

@{
    ViewData["Title"] = "Mantenimiento de Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark fw-bold m-0">Mantenimiento de Usuarios</h2>
            <p class="text-muted small mb-0">Administra los accesos y roles del personal del sistema electoral.</p>
        </div>
        <a asp-action="Crear" class="btn btn-primary d-flex align-items-center gap-2 px-4 shadow-sm">
            <i class="bi bi-person-plus-fill"></i> Registrar Nuevo Usuario
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-start border-danger border-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Nombre Completo</th>
                            <th class="py-3">Nombre de Usuario</th>
                            <th class="py-3">Correo Electrónico</th>
                            <th class="py-3">Rol / Perfil</th>
                            <th class="py-3 text-center">Estado</th>
                            <th class="py-3 text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-people fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    No hay usuarios registrados en el sistema.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var usuario in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">
                                        @usuario.Nombre @usuario.Apellido
                                    </td>
                                    <td>
                                        <code class="text-secondary bg-light px-2 py-1 rounded small">@@@usuario.NombreUsuario</code>
                                    </td>
                                    <td class="text-muted">@usuario.Correo</td>
                                    <td>
                                        <span class="badge @(usuario.Rol == "Administrador" ? "bg-purple-light text-purple" : "bg-info-light text-info") rounded-pill px-3 py-2 small fw-semibold">
                                            @usuario.Rol
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill px-3 py-1 fw-medium @(usuario.Estado ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle")">
                                            @(usuario.Estado ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end align-items-center gap-2">
                                            <a asp-action="Editar" asp-route-id="@usuario.Id" class="btn btn-outline-secondary btn-sm rounded-2" title="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            
                                            <form asp-action="CambiarEstado" asp-route-id="@usuario.Id" method="post" class="d-inline m-0">
                                                <button type="submit" class="btn btn-sm rounded-2 @(usuario.Estado ? "btn-outline-danger" : "btn-outline-success")" 
                                                        title="@(usuario.Estado ? "Desactivar" : "Activar")"
                                                        onclick="return confirm('¿Está seguro de que desea cambiar el estado de este usuario?');">
                                                    <i class="bi @(usuario.Estado ? "bi-toggle-on fs-5" : "bi-toggle-off fs-5")"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-purple-light { background-color: #f3e8ff; }
    .text-purple { color: #6b21a8; }
    .bg-info-light { background-color: #e0f2fe; }
    .text-info { color: #0369a1; }
</style>