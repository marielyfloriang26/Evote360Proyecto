@model Evote360.Application.ViewModels.Administrador.HomeAdministradorViewModel

@{
    ViewData["Title"] = "Panel Principal de Administración";
}

<div class="container my-4">
    
    <!-- Notificaciones de Sistema -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <strong>Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
            <strong>Información:</strong> @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Encabezado Principal -->
    <div class="text-center my-4">
        <h1 class="display-6 fw-bold text-primary">Panel Principal de Administración</h1>
    </div>

    <!-- Menú Superior Original Restaurado -->
    <div class="card shadow-sm border-1 mb-4">
        <div class="card-body bg-light py-3">
            <div class="row g-2 text-center">
                <div class="col-md-2 col-sm-4 col-6">
                    <a asp-controller="PuestoElectivo" asp-action="Index" class="btn btn-outline-primary w-100 py-2 text-truncate">Puesto Electivo</a>
                </div>
                <div class="col-md-2 col-sm-4 col-6">
                    <a asp-controller="Ciudadano" asp-action="Index" class="btn btn-outline-primary w-100 py-2 text-truncate">Ciudadano</a>
                </div>
                <div class="col-md-2 col-sm-4 col-6">
                    <a asp-controller="PartidoPolitico" asp-action="Index" class="btn btn-outline-primary w-100 py-2 text-truncate">PartidoPolitico</a>
                </div>
                <div class="col-md-2 col-sm-4 col-6">
                    <a asp-controller="Usuario" asp-action="Index" class="btn btn-outline-primary w-100 py-2 text-truncate">Usuario</a>
                </div>
                <div class="col-md-2 col-sm-4 col-6">
                    <a asp-controller="AsignacionDirigentePolitico" asp-action="Index" class="btn btn-outline-primary w-100 py-2 text-truncate">AsignacionDirigentePolitico</a>
                </div>
                <div class="col-md-2 col-sm-4 col-6">
                    <a asp-controller="Elecciones" asp-action="Index" class="btn btn-outline-primary w-100 py-2 text-truncate">Elecciones</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenedor del Filtro y Resultados -->
    <div class="card shadow-sm border-1">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 text-secondary fw-bold">Resumen Electoral por Año</h5>
        </div>
        <div class="card-body">
            
            <!-- Formulario de Selección de Año -->
            <form asp-controller="Administrador" asp-action="ObtenerResumen" method="post" class="mb-4">
                <div class="row align-items-end g-3">
                    <div class="col-md-8">
                        <label asp-for="AnioElectoral" class="form-label fw-bold small text-muted">Año electoral *</label>
                        <select asp-for="AnioElectoral" class="form-select py-2" asp-items="@(new SelectList(Model.AniosDisponibles))" disabled="@(Model.AniosDisponibles.Count == 0)">
                            <option value="">Seleccione un año</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" disabled="@(Model.AniosDisponibles.Count == 0)">
                            Obtener Resumen Electoral
                        </button>
                    </div>
                </div>
            </form>

            <!-- Tabla Detallada del Resumen -->
            @if (Model.EleccionesResumen != null && Model.EleccionesResumen.Count > 0)
            {
                <div class="table-responsive border rounded">
                    <table class="table table-striped table-hover mb-0 align-middle small text-center">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th class="text-start ps-3">Nombre de la elección</th>
                                <th>Fecha de realización</th>
                                <th>Cantidad de partidos participantes</th>
                                <th>Cantidad de candidatos participantes</th>
                                <th>Cantidad de ciudadanos que votaron</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var eleccion in Model.EleccionesResumen)
                            {
                                <tr>
                                    <td class="text-start ps-3 fw-bold text-dark">@eleccion.NombreEleccion</td>
                                    <td class="text-muted">@eleccion.FechaRealizacion</td>
                                    <td class="fw-bold">@eleccion.CantidadPartidos</td>
                                    <td class="fw-bold">@eleccion.CantidadCandidatosReales</td>
                                    <td class="fw-bold text-primary">@eleccion.CantidadCiudadanosVotaron</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>