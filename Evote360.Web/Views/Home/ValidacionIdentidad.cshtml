@model Evote360.Application.ViewModels.Votacion.ValidacionIdentidadViewModel
@{
    ViewData["Title"] = "Validar Identidad";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-0 fw-bold">Validación de Identidad</h3>
                </div>
                <div class="card-body p-5">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @ViewBag.ErrorMessage
                        </div>
                    }

                    <p class="text-muted text-center mb-4">
                        Por favor, suba una foto de la parte frontal de su cédula. El sistema extraerá su número de documento para validar su identidad.
                    </p>

                    <form asp-action="ValidacionIdentidad" method="post" enctype="multipart/form-data">
                        <div class="mb-4">
                            <label asp-for="ImagenCedula" class="form-label fw-bold text-secondary"></label>
                            <input asp-for="ImagenCedula" type="file" accept=".jpg,.jpeg,.png" class="form-control form-control-lg bg-light" />
                            <span asp-validation-for="ImagenCedula" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">
                                Validar identidad
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
