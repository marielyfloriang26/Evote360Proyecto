@model IEnumerable<Evote360.Application.ViewModels.Votacion.PuestoDisponibleViewModel>
@{
    ViewData["Title"] = "Puestos Electivos Disponibles";
}

<div class="container mt-5">
    <h2 class="mb-4 text-center fw-bold text-primary">Puestos Electivos</h2>
    <p class="text-center text-muted mb-5">Seleccione un candidato para cada puesto electivo disponible.</p>

    <div class="row">
        @foreach (var puesto in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0 @(puesto.YaSelecciono ? "border-success border-2" : "")">
                    <div class="card-body d-flex flex-column">
                        <h4 class="card-title text-dark fw-bold">@puesto.NombrePuesto</h4>
                        
                        <div class="mt-3 mb-4 flex-grow-1">
                            <p class="mb-1 text-secondary">
                                <i class="bi bi-diagram-3-fill me-2"></i>Partidos participantes: <strong>@puesto.PartidosParticipantes</strong>
                            </p>
                            <p class="mb-1 text-secondary">
                                <i class="bi bi-people-fill me-2"></i>Candidatos reales: <strong>@puesto.CandidatosReales</strong>
                            </p>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-auto border-top pt-3">
                            <div>
                                @if (puesto.YaSelecciono)
                                {
                                    <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle me-1"></i>Selección completada</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2"><i class="bi bi-exclamation-circle me-1"></i>Pendiente</span>
                                }
                            </div>
                            
                            <a href="@Url.Action("Boleta", "Home", new { id = puesto.PuestoId })" class="btn btn-outline-primary fw-bold">
                                @(puesto.YaSelecciono ? "Modificar voto" : "Seleccionar candidato")
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-5 mb-5 border-top pt-4">
        @if (Model.All(p => p.YaSelecciono) && Model.Any())
        {
            <form asp-action="FinalizarVotacion" method="post" class="d-inline">
                <button type="submit" class="btn btn-success btn-lg fw-bold px-5">
                    Finalizar votación
                </button>
            </form>
            <p class="text-muted small mt-2">Ha completado la selección en todos los puestos.</p>
        }
        else
        {
            <button class="btn btn-success btn-lg fw-bold px-5" disabled>
                Finalizar votación
            </button>
            <p class="text-muted small mt-2">Complete la selección en todos los puestos para habilitar este botón.</p>
        }
    </div>
</div>
