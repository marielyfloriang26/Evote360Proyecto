@{
    ViewData["Title"] = "Votación Completada";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card shadow border-0 rounded-lg p-5 bg-light">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 6rem;"></i>
                <h1 class="display-5 fw-bold text-dark mt-3">¡Votación Completada!</h1>
                <p class="lead text-muted mt-3">
                    Su voto ha sido registrado exitosamente de manera anónima.
                </p>
                <div class="alert alert-info mt-4" role="alert">
                    <i class="bi bi-envelope-check-fill me-2"></i> Hemos enviado un correo electrónico con el comprobante y el resumen de su selección.
                </div>
                <div class="mt-5">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg fw-bold px-5">
                        Volver al Inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
